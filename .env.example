# Copy this file to .env and fill in your own values.
# .env is loaded automatically on startup (see weather_agent/main.py).

# Required: your OpenAI API key.
OPENAI_API_KEY=

# Optional: model name (defaults to gpt-4o if unset).
OPENAI_MODEL=gpt-4o

# Optional: override the API base URL to point at any other
# OpenAI-compatible endpoint (Azure OpenAI, local LM Studio/Ollama, Groq, etc.).
# Leave unset to use OpenAI's default endpoint.
# OPENAI_BASE_URL=

# Optional: model used only by the agent_eval test suite's LLM judge (tests/), which
# grades the agent's answers. Defaults to gpt-4o if unset.
# OPENAI_JUDGE_MODEL=gpt-4o
